
foods = []
prices = []
total = 0

while True:
    food = input("Enter the food you would like to buy (q to quit): ")
    if food.lower() == "q":
        break
    else:
        price = float(input("How much is what you would like to buy? $"))
        foods.append(food)
        prices.append(price)

print("Your cart:")
for food in foods:
    print(food, end= " ")

for price in prices:
    total += price

print()
print(f"Your total is: ${total}")